{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "doctrine/dbal": "^3.5",
        "inertiajs/inertia-laravel": "^1.0",
        "laravel/framework": "^11.51",
        "laravel/horizon": "^5.22",
        "laravel/jetstream": "^5.0",
        "laravel/nightwatch": "^1.13",
        "laravel/reverb": "^1.12",
        "laravel/sanctum": "^4.0",
        "laravel/spark-paddle": "1.2.1",
        "laravel/tinker": "^2.9",
        "league/flysystem-aws-s3-v3": "^3.35",
        "mtvs/eloquent-hashids": "^3.5",
        "pusher/pusher-php-server": "^7.2",
        "sentry/sentry-laravel": "^4.3",
        "spatie/eloquent-sortable": "^4.2",
        "symfony/http-client": "^7.0",
        "symfony/mailgun-mailer": "^7.0",
        "tightenco/ziggy": "^2.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/dusk": "^8.0",
        "laravel/pail": "^1.1",
        "laravel/sail": "^1.26",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.1",
        "phpunit/phpunit": "^11.0.1"
    },
    "config": {
        "platform": {
            "php": "8.2"
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "deploy": [
            "npm run build",
            "@php artisan migrate --force",
            "@php artisan route:cache",
            "@php artisan view:cache",
            "@php artisan horizon:publish",
            "@php artisan horizon:terminate",
            "@php artisan spark:install"
        ],
        "clear": [
            "@php artisan cache:clear",
            "@php artisan config:clear",
            "@php artisan route:clear",
            "@php artisan view:clear"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ]
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://spark.laravel.com"
        }
    ]
}
